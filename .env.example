# ===============================
# n8n Geospatial - Exemple .env
# ===============================
# Renommez ce fichier en `.env` et adaptez les valeurs à votre environnement

# --- Sécurité / n8n ---
N8N_ENCRYPTION_KEY=your-secure-encryption-key-here
N8N_RUNNERS_AUTH_TOKEN=your-secure-runner-auth-token-here

# --- Base de données Postgres/PostGIS ---
# Option 1 (recommandée): URL unique
# DATABASE_URL=postgresql://geo:geo_password@postgis:5432/cadastre

# Option 2: Variables PG* (priorité après DATABASE_URL)
PGHOST=postgis
PGPORT=5432
PGUSER=geo
PGPASSWORD=geo_password
PGDATABASE=cadastre

# Option 3: Variables type docker-compose (fallback)
DB_POSTGRESDB_HOST=postgis
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=geo
DB_POSTGRESDB_PASSWORD=geo_password
DB_POSTGRESDB_DATABASE=cadastre

# --- Paramètres géospatiaux / GDAL/PROJ ---
GDAL_CACHEMAX=1024
GDAL_NUM_THREADS=ALL_CPUS
PROJ_NETWORK=ON

# --- Répertoires (utilisés par certains scripts) ---
# Dans le conteneur: /files, /geodata, /tmp/geodata-cache
# En local (dev), vous pouvez créer: ./files, ./geodata, ./tmp/geodata-cache

# --- Notifications / Webhooks ---
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- N8N / Accès ---
# N8N_PORT=5678
# BASE_URL=http://localhost:5678
