        "bodyParametersJson": "{\"tool_name\":\"ping\",\"params\":{\"source\":\"n8n\"}}",
        "options": {}
      },
      "name": "Invoke MCP ping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300]
    },
    {
