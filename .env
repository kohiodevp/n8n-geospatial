# =============================================================================
# FICHIER DE CONFIGURATION ENVIRONNEMENT - n8n Géospatial Workflow Runner
# =============================================================================
# Ce fichier contient les variables d'environnement pour le projet n8n avec
# fonctionnalités géospatiales et IA. Les valeurs par défaut sont configurées
# pour un environnement de développement local.
# =============================================================================

# =============================================================================
# CONFIGURATION D'AUTHENTIFICATION ET SÉCURITÉ
# =============================================================================
# Activation de l'authentification basique
N8N_BASIC_AUTH_ACTIVE=true

# Informations d'identification pour l'interface admin
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cadastre2024

# Gestion des utilisateurs
N8N_USER_MANAGEMENT_DISABLED=false

# =============================================================================
# CONFIGURATION SERVEUR
# =============================================================================
# Hôte et port pour l'application n8n
N8N_HOST=0.0.0.0
N8N_PORT=5678
PORT=5678

# Protocole et URL
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# =============================================================================
# CONFIGURATION BASE DE DONNÉES POSTGIS (nécessaire pour les fonctionnalités géospatiales)
# =============================================================================
# Type de base de données
DB_TYPE=postgresdb

# Paramètres de connexion PostGIS
DB_POSTGRESDB_HOST=postgis
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8npassword

# Configuration PostGIS spécifique
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=false

# URL de connexion directe (alternative à la configuration détaillée)
DATABASE_URL=postgresql://n8n:n8npassword@postgis:5432/n8n

# =============================================================================
# CONFIGURATION DES EXÉCUTEURS (Runners) - Essentiel pour le traitement géospatial
# =============================================================================
# Mode d'exécution des runners (essentiel pour les traitements lourds géospatiaux)
N8N_RUNNERS_MODE=internal
N8N_RUNNERS_ENABLED=true

# Token d'authentification requis pour le mode runner externe
N8N_RUNNERS_AUTH_TOKEN=your_secure_runner_auth_token_here

# Configuration du health check
QUEUE_HEALTH_CHECK_ACTIVE=true

# =============================================================================
# CONFIGURATION DES FONCTIONS PERSONNALISÉES (nécessaire pour les bibliothèques géospatiales)
# =============================================================================
# Autoriser les modules externes pour les fonctions JavaScript/Python
NODE_FUNCTION_ALLOW_EXTERNAL=axios,lodash,moment,geopandas,shapely,rasterio,pyproj,sklearn

# Exclure des nœuds spécifiques pour des raisons de sécurité
NODES_EXCLUDE=n8n-nodes-base.executeCommand

# Autoriser l'exécution de commandes (nécessaire pour les outils CLI géospatiaux)
N8N_ENABLE_EXECUTE_COMMAND=true

# Options de configuration additionnelles pour Node.js
NODE_OPTIONS="--dns-result-order=ipv4first --max-old-space-size=4096"

# =============================================================================
# CONFIGURATION DE SÉCURITÉ ET CHIFFREMENT
# =============================================================================
# Clé de chiffrement pour les identifiants et données sensibles
# ATTENTION : Cette clé devrait être changée en production
N8N_ENCRYPTION_KEY=1a8c367948237c94ecf10f9cfa83f10bc6fa1944b4babe518c3196b0d0984d89

# Gestion du JWT pour l'authentification
N8N_USER_MANAGEMENT_JWT_SECRET=generate_secure_jwt_secret_for_production

# Désactiver les diagnostics en production pour des raisons de sécurité
N8N_DIAGNOSTICS_ENABLED=false

# =============================================================================
# CONFIGURATION GÉOGRAPHIQUE ET LOCALISATION
# =============================================================================
# Fuseau horaire (important pour les traitements géospatiaux)
GENERIC_TIMEZONE=Africa/Ouagadougou
TZ=Africa/Ouagadougou

# Localisation par défaut
N8N_DEFAULT_LOCALE=fr

# =============================================================================
# CONFIGURATION LOGGING
# =============================================================================
# Niveau de log (debug, info, warn, error)
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=file,console

# =============================================================================
# CONFIGURATION SPÉCIFIQUE GÉOSPATIALE
# =============================================================================
# Variables d'environnement pour les outils géospatiaux
GDAL_CACHEMAX=2048
GDAL_NUM_THREADS=ALL_CPUS
PROJ_NETWORK=ON
QT_QPA_PLATFORM=offscreen

# Dossiers de travail géospatial
N8N_WORKFLOW_DATA_HOME=/files
N8N_GEOSPATIAL_DATA_HOME=/geodata
N8N_QGIS_OUTPUT_HOME=/qgis-output

# =============================================================================
# CONFIGURATION PERFORMANCE OPTIMISÉE
# =============================================================================
# Configuration de la mémoire pour les traitements géospatiaux intensifs
N8N_MEMORY_LIMIT_NORMAL=64
N8N_MEMORY_LIMIT_MAIN_PROCESS=1024

# Configuration du cache pour les opérations géospatiales
N8N_CACHE_SIZE=200
N8N_BINARY_DATA_CACHE_SIZE=100

# =============================================================================
# CONFIGURATION DES FONCTIONNALITÉS AVANCÉES
# =============================================================================
# Désactiver les fonctionnalités non nécessaires pour améliorer la sécurité
N8N_EXTERNAL_FRONTEND_HOOKS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false

# Configuration de la limite de taille des fichiers uploadés (important pour les données géospatiales)
N8N_BINARY_DATA_MODE=filesystem
N8N_BINARY_DATA_S3_BUCKET=n8n-geospatial-bucket
# N8N_BINARY_DATA_TTL has been deprecated, removing it

# Configuration des timeouts pour les traitements géospatiaux intensifs
N8N_EXTERNAL_HOOKS_HTTP_NODES_TIMEOUT=300
N8N_EXTERNAL_HOOKS_HTTP_NODES_CONNECTION_TIMEOUT=300
N8N_REQUEST_TIMEOUT=300000
N8N_TASK_RUNNERS_TIMEOUT=300

# =============================================================================
# CONFIGURATION SÉCURITÉ RENFORCÉE
# =============================================================================
# Désactiver les fonctionnalités potentiellement dangereuses
N8N_EXTERNAL_HOOKS_HTTP_NODES_TIMEOUT=120
N8N_EXTERNAL_HOOKS_HTTP_NODES_CONNECTION_TIMEOUT=120
N8N_CODE_NODE_ALLOW_BUILTIN_REQUIRE_PACKAGES=true
N8N_CODE_NODE_PASTE_IN_EDITOR_ENABLED=false

# =============================================================================
# VARIABLES POUR LE DÉPLOIEMENT SUR RENDER (à décommenter en production)
# =============================================================================
# N8N_LISTEN_ADDRESS=0.0.0.0
# DB_POSTGRESDB_SSL_ENABLED=true
# N8N_RUNNERS_MODE=external
# QUEUE_HEALTH_CHECK_ACTIVE=true
# N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}
# N8N_USER_MANAGEMENT_JWT_SECRET=${N8N_USER_MANAGEMENT_JWT_SECRET}
# DATABASE_URL=${DATABASE_URL}
# =============================================================================